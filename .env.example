APP_ENV=development
ALLOW_MOCK_DATA=false
MODEL_DIR=artifacts/models
METADATA_DIR=artifacts/metadata
DATA_DIR=data
BASELINE_PREDICTIONS_PATH=data/predictions.csv
BASELINE_OHLC_PATH=data/ohlc.csv
DEFAULT_SYMBOL=CL=F
DEFAULT_INTERVAL=1d
DATA_STALE_THRESHOLD_SECONDS=86400
ENABLE_LLM_CONTEXT=true
ENABLE_EXTERNAL_LLM_CALLS=false
LLM_CONTEXT_MODE=google_generative
LLM_API_KEY=
LLM_MODEL=gemma-3-27b-it
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta
LOCAL_LLM_API_BASE=http://localhost:11434/api/chat
LOCAL_LLM_MODEL=local-context-encoder
NEWS_EVENTS_PATH=data/raw/news/public_market_news.csv
MARKET_EVENTS_PATH=
ECONOMIC_EVENTS_PATH=
ENABLE_EXTERNAL_FEATURES=false
ENABLE_CROSS_ASSET_FEATURES=true
