APP_ENV=development
ALLOW_MOCK_DATA=false
MODEL_DIR=artifacts/models
METADATA_DIR=artifacts/metadata
DATA_DIR=data
BASELINE_PREDICTIONS_PATH=data/predictions.csv
BASELINE_OHLC_PATH=data/ohlc.csv
DEFAULT_SYMBOL=NYMEX:CL1!
DEFAULT_INTERVAL=1d
DATA_STALE_THRESHOLD_SECONDS=86400
ENABLE_LLM_CONTEXT=false
LLM_API_KEY=
LLM_MODEL=context-encoder-placeholder
ENABLE_EXTERNAL_FEATURES=false
ENABLE_CROSS_ASSET_FEATURES=false
